{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athenaeum.example/formats/ath/2.0/schema.json",
  "title": "Athenaeum project archive (.ath), version 2.0",
  "description": "A project's corpus and its record: nuclei and the prompts that grew them, papers as nodes with their per-nucleus reviews and verbatim evidence, lineage and semantic edges, and the archive sections carried over from version 1. Results are stored, not only prompts. Every quote carries a W3C TextQuoteSelector; no paper's full text is included. The id and the @context namespace are placeholders until published.",
  "type": "object",
  "properties": {
    "@context": {
      "type": "object"
    },
    "format": {
      "const": "ath"
    },
    "version": {
      "const": "2.0"
    },
    "exported_at": {
      "$ref": "#/$defs/datetime"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "license"
      ],
      "additionalProperties": false
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "openalex_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "authors_json": {},
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "abstract": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "$ref": "#/$defs/datetime"
          },
          "in_library": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "doi",
          "openalex_id",
          "title",
          "authors_json",
          "venue",
          "year",
          "abstract",
          "status",
          "created_at",
          "in_library"
        ],
        "additionalProperties": false
      }
    },
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "paper_id": {
            "$ref": "#/$defs/uuid"
          },
          "sentence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verbatim_text": {
            "type": "string"
          },
          "selector": {
            "anyOf": [
              {
                "$ref": "#/$defs/textQuoteSelector"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "verified_at": {
            "$ref": "#/$defs/datetime"
          },
          "checker_model": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "paper_id",
          "sentence_ids",
          "verbatim_text",
          "selector",
          "verified",
          "verified_at",
          "checker_model"
        ],
        "additionalProperties": false
      }
    },
    "syntheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "claim_text": {
            "type": "string"
          },
          "synthesis_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieval_corpus": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "checker_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "relevance_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "run_at": {
            "$ref": "#/$defs/datetime"
          },
          "query_expansion_json": {},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "passage_id": {
                  "$ref": "#/$defs/uuid"
                },
                "role": {
                  "type": "string"
                },
                "ord": {
                  "type": "integer"
                }
              },
              "required": [
                "passage_id",
                "role",
                "ord"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "claim_text",
          "synthesis_text",
          "retrieval_corpus",
          "model",
          "checker_model",
          "verification_rate",
          "relevance_rate",
          "status",
          "run_at",
          "query_expansion_json",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "author_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "assertion": {
            "type": "string"
          },
          "built_from_synthesis_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "locked_at": {
            "$ref": "#/$defs/datetime"
          },
          "drafted_at": {
            "$ref": "#/$defs/datetime"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target_kind": {
                  "type": "string"
                },
                "target_id": {
                  "$ref": "#/$defs/uuid"
                },
                "role": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "paper_id": {
                  "$ref": "#/$defs/uuid"
                }
              },
              "required": [
                "target_kind",
                "target_id",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "to_statement_id": {
                  "$ref": "#/$defs/uuid"
                },
                "relation": {
                  "type": "string"
                }
              },
              "required": [
                "to_statement_id",
                "relation"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "author_id",
          "type",
          "status",
          "assertion",
          "built_from_synthesis_id",
          "locked_at",
          "drafted_at",
          "evidence",
          "edges"
        ],
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "author_id": {
            "$ref": "#/$defs/uuid"
          },
          "target_kind": {
            "type": "string"
          },
          "target_id": {
            "$ref": "#/$defs/uuid"
          },
          "body": {
            "type": "string"
          },
          "created_at": {
            "$ref": "#/$defs/datetime"
          }
        },
        "required": [
          "id",
          "author_id",
          "target_kind",
          "target_id",
          "body",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "compose_document": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "content_json": {},
            "version": {
              "type": "integer"
            },
            "updated_by": {
              "anyOf": [
                {
                  "$ref": "#/$defs/uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "updated_at": {
              "$ref": "#/$defs/datetime"
            }
          },
          "required": [
            "id",
            "content_json",
            "version",
            "updated_by",
            "updated_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "paper_id": {
            "$ref": "#/$defs/uuid"
          },
          "sentence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verbatim_text": {
            "type": "string"
          },
          "selector": {
            "anyOf": [
              {
                "$ref": "#/$defs/textQuoteSelector"
              },
              {
                "type": "null"
              }
            ]
