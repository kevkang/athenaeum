                  "null"
                ]
              },
              "venue": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "title",
              "authors",
              "year",
              "venue",
              "doi"
            ],
            "additionalProperties": false
          },
          "fulltext": {
            "type": "string",
            "enum": [
              "available",
              "abstract_only",
              "user_must_supply"
            ]
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nucleus": {
                  "$ref": "#/$defs/uuid"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "frontier",
                    "accepted",
                    "rejected",
                    "pinned"
                  ]
                },
                "rejection_reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "relevance": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "provenance": {
                          "$ref": "#/$defs/provenance"
                        },
                        "audit": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "supported": {
                                  "type": "boolean"
                                },
                                "rationale": {
                                  "type": "string"
                                },
                                "checked": {
                                  "$ref": "#/$defs/datetime"
                                }
                              },
                              "required": [
                                "supported",
                                "rationale",
                                "checked"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "text",
                        "provenance",
                        "audit"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "selection_reasoning": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              },
              "required": [
                "nucleus",
                "status",
                "rejection_reason",
                "relevance",
                "selection_reasoning",
                "evidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "type",
          "paper",
          "metadata",
          "fulltext",
          "reviews"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "lineage"
              },
              "nucleus": {
                "$ref": "#/$defs/uuid"
              },
              "from_kind": {
                "type": "string",
                "enum": [
                  "nucleus",
                  "node"
                ]
              },
              "from": {
                "type": "string",
                "description": "The nucleus id, or a node."
              },
              "to": {
                "$ref": "#/$defs/nodeRef"
              },
              "prompt": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "retrieval_source": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "library",
                      "openalex",
                      "web"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "created": {
                "$ref": "#/$defs/datetime"
              }
            },
            "required": [
              "kind",
              "nucleus",
              "from_kind",
              "from",
              "to",
              "prompt",
              "retrieval_source",
              "created"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "semantic"
              },
              "from": {
                "$ref": "#/$defs/nodeRef"
              },
              "to": {
                "$ref": "#/$defs/nodeRef"
              },
              "relation": {
                "$ref": "#/$defs/relation"
              },
              "proposed_relation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/relation"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              },
              "rationale": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rejected": {
                "type": "boolean"
              },
              "rejection_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "created_by": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "created": {
                "$ref": "#/$defs/datetime"
              }
            },
            "required": [
              "kind",
              "from",
              "to",
              "relation",
              "proposed_relation",
              "provenance",
              "rationale",
              "rejected",
              "rejection_reason",
              "evidence",
              "created_by",
              "created"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "@context",
    "format",
    "version",
    "exported_at",
    "project",
    "papers",
    "passages",
    "syntheses",
    "statements",
    "annotations",
    "compose_document",
    "highlights",
    "evaluations",
    "datasets",
    "provenance",
    "nuclei",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "datetime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "nodeRef": {
      "type": "string",
      "pattern": "^(doi:.+|urn:uuid:[0-9a-f-]{36})$",
      "description": "A node: doi:<DOI>, or urn:uuid:<paper id> for a paper with no DOI."
    },
    "textQuoteSelector": {
      "description": "W3C Web Annotation TextQuoteSelector: the quote, and the characters either side of it.",
      "type": "object",
      "properties": {
        "type": {
          "const": "TextQuoteSelector"
        },
        "exact": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "exact"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "description": "A verbatim quote, located by its selector. Never a paper's full text.",
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "full_text",
            "abstract"
          ]
        },
        "selector": {
          "$ref": "#/$defs/textQuoteSelector"
        }
      },
      "required": [
        "source",
        "selector"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "string",
      "enum": [
        "ai_proposed",
        "ai_proposed_accepted",
        "ai_proposed_corrected",
        "user_set"
      ]
    },
    "relation": {
      "type": "string",
      "enum": [
        "uses_method_of",
        "uses_data_from",
        "extends",
        "supports",
        "disagrees_with",
        "obtains_background_from"
      ],
      "description": "Read 'from <relation> to'. The @context maps each term to its CiTO IRI."
    }
  }
}
