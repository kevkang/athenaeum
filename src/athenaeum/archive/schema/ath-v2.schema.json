                            "running",
                            "done",
                            "failed",
                            "cancelled"
                          ]
                        },
                        "budget": {
                          "type": "integer"
                        },
                        "model": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "input_tokens": {
                          "type": "integer"
                        },
                        "output_tokens": {
                          "type": "integer"
                        },
                        "reply_text": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "started": {
                          "$ref": "#/$defs/datetime"
                        },
                        "finished": {
                          "$ref": "#/$defs/datetime"
                        }
                      },
                      "required": [
                        "status",
                        "budget",
                        "model",
                        "input_tokens",
                        "output_tokens",
                        "reply_text",
                        "started",
                        "finished"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "text",
                "anchor_nodes",
                "created_by",
                "created",
                "run"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "question",
          "created_by",
          "created",
          "prompts"
        ],
        "additionalProperties": false
      }
