                    {
                      "$ref": "#/$defs/uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "created": {
                  "$ref": "#/$defs/datetime"
                },
                "run": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
