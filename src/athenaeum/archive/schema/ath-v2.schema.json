          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "storage_uri",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "project_seq": {
            "type": [
              "integer",
              "null"
            ]
          },
          "actor_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string"
          },
          "entity_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "entity_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "prev_json": {},
          "payload_json": {},
          "created_at": {
            "$ref": "#/$defs/datetime"
          }
        },
        "required": [
          "id",
          "project_seq",
          "actor_id",
          "kind",
          "entity_kind",
          "entity_id",
          "prev_json",
          "payload_json",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "nuclei": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "question": {
            "type": "string"
          },
          "created_by": {
            "anyOf": [
              {
                "$ref": "#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "created": {
            "$ref": "#/$defs/datetime"
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "object",
