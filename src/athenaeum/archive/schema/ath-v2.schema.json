          },
          "passage_id": {
            "$ref": "#/$defs/uuid"
          },
          "user_id": {
            "$ref": "#/$defs/uuid"
          },
          "stance": {
            "type": "string"
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "$ref": "#/$defs/datetime"
          }
        },
        "required": [
          "id",
          "synthesis_id",
          "passage_id",
          "user_id",
          "stance",
          "body",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "storage_uri": {
            "type": [
              "string",
