# Copy to .env.production and fill in all values before deploying.

ENVIRONMENT=production

# Internal Docker service URLs — leave as-is
DATABASE_URL=postgresql+asyncpg://athenaeum:athenaeum@postgres:5432/athenaeum
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-to-a-strong-password
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Register at https://orcid.org/developer-tools (production) or sandbox.orcid.org (testing)
# Redirect URI must be registered in the ORCID app settings
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=https://api.athenaindex.app/auth/orcid/callback
ORCID_API_BASE=https://sandbox.orcid.org

FRONTEND_URL=https://athenaindex.app

GROBID_URL=http://grobid:8070
UNPAYWALL_EMAIL=

ANTHROPIC_API_KEY=

# S3 for PDF/TXT uploads (uses EC2 instance role — no keys needed if IAM role is attached)
# Leave S3_ENDPOINT_URL unset here — it's only for pointing at local MinIO in dev
# (see docker-compose.yml); omitting it makes boto3 hit real AWS S3.
S3_BUCKET=athenaeum-papers
AWS_REGION=us-east-1

# Zotero integration — encrypts per-user Zotero API keys at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
ZOTERO_API_BASE=https://api.zotero.org
