DATABASE_URL=postgresql+asyncpg://athenaeum:athenaeum@localhost:5432/athenaeum
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=athenaeum
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# Register a public client at https://orcid.org/developer-tools
# Use sandbox.orcid.org for development; orcid.org for production
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:8000/auth/orcid/callback
ORCID_API_BASE=https://sandbox.orcid.org
FRONTEND_URL=http://localhost:5173

# Phase 1 — ingestion
GROBID_URL=http://localhost:8070
UNPAYWALL_EMAIL=contact@athenaeum.app
EMBED_MODEL=BAAI/bge-base-en-v1.5

# Phase 3 — synthesis
ANTHROPIC_API_KEY=
SYNTHESIS_MODEL=claude-opus-4-7
CHECKER_MODEL=claude-opus-4-7

# Zotero integration
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
ZOTERO_API_BASE=https://api.zotero.org

# Zotero (local) — only for a single-operator local deployment. docker-compose.yml
# already bind-mounts your whole home directory read-only (no setup needed here);
# pick which subfolder is your actual Zotero data directory from the app's
# Zotero (Local) tab ("Select local library") instead of an env var.
ZOTERO_LOCAL_HOST_MOUNT=/host-home
